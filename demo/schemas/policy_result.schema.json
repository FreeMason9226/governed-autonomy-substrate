{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAA demo policy result",
  "type": "object",
  "required": ["schema_version", "status", "requires_human_approval", "pr_number", "head_sha", "reasons", "input_digest"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gaa-demo-policy-result/v1"},
    "status": {"enum": ["pass", "flag_requires_human_approval"]},
    "requires_human_approval": {"type": "boolean"},
    "pr_number": {"type": "integer"},
    "head_sha": {"type": "string"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
